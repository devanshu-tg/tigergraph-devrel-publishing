{
  "_help": [
    "Each block describes one kind of submissions export. Pick it with --source <name>.",
    "Column lists: possible column names, first one found is used (case, spaces and punctuation are ignored; a column that starts with the name also counts).",
    "title_from_first_line: the title is the first line of the title column (for 'Project Title and Description' style columns).",
    "title_fallback_repo_name: if there is no title, use the repo name ('fraud-ring-ui' -> 'Fraud Ring Ui').",
    "extra_sections: columns added to the description under their own heading. Use {\"column\": ..., \"label\": ...} to rename the heading.",
    "details: columns shown as a bullet list. metrics_table: columns shown as a results table. links: columns shown as a list of links.",
    "timestamp + dedupe_by: repeat submissions (same repo, or same value in a dedupe_by column such as the submitter's email) keep the latest one. These values are only used for matching, never written to the site.",
    "exclude: team names or repo URLs to leave out. force_include: import even if the repo is private/missing or the description is short.",
    "skip_text_pattern / min_section_length: ignore extra-section text that matches the pattern or is shorter than this.",
    "Personal data (emails, phone numbers, addresses) is never imported: only the columns named here are read."
  ],
  "unstop": {
    "team": ["Team Name", "Team", "Team Title"],
    "title": ["Project Title", "Project Name", "Submission Title", "Idea Title", "Title"],
    "description": ["Project Description", "Submission Description", "Description", "Idea Description", "Abstract"],
    "repo_url": ["GitHub Link", "GitHub URL", "GitHub Repository", "GitHub Repo", "Repository Link", "Repository URL", "Repo URL", "Code Link"],
    "demo_url": ["Demo Link", "Demo URL", "Demo Video", "Video Link", "Live Link", "Deployed Link", "Project Link"],
    "image_url": ["Image", "Image URL", "Thumbnail", "Cover Image"],
    "title_fallback_repo_name": true,
    "timestamp": ["Timestamp", "Submission Time", "Submitted At"],
    "dedupe_by": ["Email Address", "Email", "Team ID"],
    "extra_sections": []
  },
